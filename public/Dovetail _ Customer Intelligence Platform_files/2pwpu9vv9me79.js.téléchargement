llWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":"5kMXtnxENwE","companyName":"Atlassian","customerSlug":null,"customer":{"companyName":"Atlassian","blackLogoUrl":"/customers/atlassian/black-logo.svg","whiteLogoUrl":"/customers/atlassian/white-logo.svg"},"highlightedTestimonial":null,"order":10},{"slug":"atlassian-design","heading":"How Atlassian turns customer signals into confident product decisions","industry":"Technology","featuredParagraph":"Atlassian uses Dovetail’s customer intelligence platform to give teams from Design to Engineering instant, evidence-backed answers about their customers.","gridTitle":null,"thumbnailUrl":"/media/Customer_Atlassian.png","coverImageUrl":"/media/005C_customer_story_Atlassian__1_.png","fullWidthImageUrl":"/media/Frame_1948762765.png","fullWidthVideoUrl":"/media/AtlassianStoryLoop.mp4","heroVideoId":"r1s5X72dd10","companyName":"Atlassian","customerSlug":null,"customer":{"companyName":"Atlassian","blackLogoUrl":"/customers/atlassian/black-logo.svg","whiteLogoUrl":"/customers/atlassian/white-logo.svg"},"highlightedTestimonial":{"testimonialId":"5bvB3PPklhUue3gUTGKKJ2","testimonial":"I want to literally chat with nine hours of the footage that we have: ‘What do they think about this? What do they think about that?’ I want to really test my own assumptions very quickly.","person":{"name":"Martin Jerkovic","jobTitle":"Lead Product Designer"}},"order":2},{"slug":"aws","heading":"Dovetail helps AWS turn scattered research into a shared source of customer truth","industry":"Technology","featuredParagraph":"With research scattered across FigJam canvases, Chime recordings, and UserTesting exports, AWS teams had no single place to discover what their customers had already told them. Dovetail became the shared repository that connects research across more than 25 teams—making customer intelligence accessible to anyone, not just the people who ran the study.","gridTitle":null,"thumbnailUrl":"/media/Customer_AWS.jpg","coverImageUrl":"/media/AWS.jpg","fullWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":"","companyName":"AWS","customerSlug":null,"customer":{"companyName":"AWS","blackLogoUrl":"/customers/aws/black-logo.svg","whiteLogoUrl":"/customers/aws/white-logo.svg"},"highlightedTestimonial":null,"order":99},{"slug":"breville","heading":"How customer insights drive and inspire Breville’s product innovation","industry":"Consumer","featuredParagraph":"Breville\'s iconic brand, built over decades, hinges on deep customer understanding. The global brand uses Dovetail to ensure every product aligns with user needs, driving brand loyalty and market leadership.","gridTitle":null,"thumbnailUrl":"/media/Customer_Breville.png","coverImageUrl":"/media/Breville.jpg","fullWidthImageUrl":"/media/CustomerStoryBrevilleLoop_copy.png","fullWidthVideoUrl":"/media/CustomerStoryBrevilleLoop.mp4","heroVideoId":"ZYFwQ6HOEsI","companyName":"Breville","customerSlug":null,"customer":{"companyName":"Breville","blackLogoUrl":"/customers/breville/black-logo.svg","whiteLogoUrl":"/customers/breville/white-logo.svg"},"highlightedTestimonial":{"testimonialId":"7dmYawH1gqbPsH6jy8COvP","testimonial":"Dovetail enables us to access all of Breville’s insights gathered from around the globe—all in one place. This is incredibly valuable and saves us from losing or repeating invaluable information about our customers.","person":{"name":"Constance Docos","jobTitle":"Senior UX Designer"}},"order":3},{"slug":"canva","heading":"Dovetail helps Canva empower the world to design, one customer insight at a time","industry":"Technology","featuredParagraph":"Even successful products like Canva need generative customer intelligence to unlock new opportunities. With the goal of \\"empowering the world to design,\\" Canva designers and product teams prioritize projects based on company strategy and knowledge gaps. Although customer obsession and product experience reviews have always been integral to Canva, their dedicated Design Research team, led by Becky White since early 2020, is a newer addition.","gridTitle":null,"thumbnailUrl":"/media/Customer_Canva.png","coverImageUrl":"/media/Canva.png","fullWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":"L9F5ffAjyzw","companyName":"Canva","customerSlug":null,"customer":{"companyName":"Canva","blackLogoUrl":"/customers/canva/black-logo.svg","whiteLogoUrl":"/customers/canva/white-logo.svg"},"highlightedTestimonial":{"testimonialId":"6qRnbo0O1QQwGoh9qVfwSY","testimonial":"One of my favorite things is seeing people not behave the way we expect them to behave. That\'s research doing what it\'s supposed to be doing; uncovering things that we were a bit uncertain about.","person":{"name":"Craig Boustred","jobTitle":"Design Researcher"}},"order":99},{"slug":"canva-ai","heading":"Dovetail helps Canva turn millions of design moments into product decisions that shape how the world designs","industry":"Technology","featuredParagraph":"Canva’s mission is to empower the world to design—but at the scale of hundreds of millions, every product decision shapes how that world looks. Dovetail’s how Canva makes sure those decisions are grounded in what customers actually say, not just what teams assume.","gridTitle":null,"thumbnailUrl":"/media/Customer_Canva_AI.png","coverImageUrl":"/media/Canva_AI_cover.jpg","fullWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":"L9F5ffAjyzw","companyName":"Canva","customerSlug":null,"customer":{"companyName":"Canva","blackLogoUrl":"/customers/canva/black-logo.svg","whiteLogoUrl":"/customers/canva/white-logo.svg"},"highlightedTestimonial":{"testimonialId":"CraigBoustredCanvaAI2026","testimonial":"One of my favorite things is seeing people not behave the way we expect them to behave.","person":{"name":"Craig Boustred","jobTitle":"Design Researcher"}},"order":2},{"slug":"careship","heading":"Careship gains a competitive advantage with fast customer intelligence","industry":"Technology","featuredParagraph":"Careship’s mission is to “fundamentally change the way care is delivered,” as stated by User Experience Researcher Anne Büttner, who emphasizes that customer intelligence is essential for the company to become “the largest and most used platform for care booking in Europe.” \\n\\nCustomer intelligence is integrated at every stage of product development, starting with the discovery phase, where professionals identify the needs and pain points of their target audience to uncover product opportunities. This process continues with prototyping and testing to determine which ideas best address user problems, and product experience review is conducted to continuously enhance the user experience. Anne highlights the importance of involving colleagues in user sessions, as she views herself as a user advocate rather than an expert, fostering a collaborative approach to understanding user needs.","gridTitle":null,"thumbnailUrl":"/media/Customer_Careship.png","coverImageUrl":"/media/Careship.png","fullWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":null,"companyName":"Careship","customerSlug":null,"customer":{"companyName":"Careship","blackLogoUrl":"/customers/careship/black-logo.svg","whiteLogoUrl":"/customers/careship/white-logo.svg"},"highlightedTestimonial":null,"order":14},{"slug":"cnh","heading":"How CNH builds better agricultural machinery, 50% faster with Dovetail","industry":"Manufacturing","featuredParagraph":"How Dovetail centralized CNH\'s vast, global customer feedback into a single system, empowering product teams to make faster, higher-quality decisions that build better agricultural machinery.","gridTitle":null,"thumbnailUrl":"/media/Customer_CNHIndustrial.png","coverImageUrl":"/media/CNH_headshot.png","fullWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":null,"companyName":"CNH","customerSlug":null,"customer":{"companyName":"CNH","blackLogoUrl":"/customers/cnh/black-logo.svg","whiteLogoUrl":"/customers/cnh/white-logo.svg"},"highlightedTestimonial":{"testimonialId":"1ka2OXSLy90XfgUKu1PwMH","testimonial":"Dovetail has been invaluable. I’ve been able to synthesize hours of customer feedback collected over the years; it would have taken months and multiple rounds of new research to identify the same insights.","person":{"name":"Matthew Klopfenstein","jobTitle":"Portfolio Management–Cash Crop Segment Specialist"}},"order":3},{"slug":"eucalyptus","heading":"Eucalyptus uses Dovetail to scale customer intelligence and shape the future of healthcare","industry":"Health","featuredParagraph":"Eucalyptus’ brands, known as “digital clinics,” specialize in areas that can be stigmatized in a traditional healthcare system. The innovative organization takes product development very seriously, so naturally, customer intelligence plays a huge role. Read on to learn how Lyena Fi, Senior Product Manager, and the Eucalyptus team are revolutionizing healthcare through customer closeness—made possible by Dovetail’s centralized platform.","gridTitle":null,"thumbnailUrl":"/media/Customer_Eucalyptus.png","coverImageUrl":"/media/Eucalyptus.png","fullWidthImageUrl":null,"fullWidthVideoUrl":null,"heroVideoId":null,"companyName":"Eucalyptus","customerSlug":null,"customer":{"companyName":"Eucalyptus","blackLogoUrl":"/customers/eucalyptus/black-logo.svg","whiteLogoUrl":"/customers/eucalyptus/white-logo.svg"},"highlightedTestimonial":null,"order":8},{"slug":"harvard-business-publishing","heading":"Dovetail fuels world-class research at Harvard Business Publishing","industry":"Consumer","featuredParagraph":"As a global name in the leadership development publishing space, Harvard Business Publishing (HBP) is a benchmark for quality and distinction. Read on to get a peek at the customer intelligence that HBP generates and how Dovetail helps them centralize and provide system-wide access to their insights while still enabling teams to stay agile and aligned.","gridTitle":null,"thumbnailUrl":"/media/Customer_Harvard.png","coverImageUrl":"/media/Harvar